classDiagram
    direction TB

    %% ══════════════════════════════════════════════════════
    %%  LAYER 1 — main (Entry Point)
    %% ══════════════════════════════════════════════════════

    namespace main {
        class Main {
            +main(args: String[]) void$
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  LAYER 2 — controller (Application Logic)
    %% ══════════════════════════════════════════════════════

    namespace controller {
        class MainController {
            -mainView : BaseView
            -dataCenterModel : DataCenterRoom
            +MainController(mainView: BaseView, dataCenterModel: DataCenterRoom)
            +initController() void
            -highlightActiveButton(activeBtn: JButton) void
        }

        class RackController {
            -rackView : RackDetailView
            -batchFormView : BatchServerFormView
            -serverDAO : ServerDAO
            -currentRack : ServerRack
            -roomModel : DataCenterRoom
            +RackController(roomModel: DataCenterRoom, currentRack: ServerRack, serverDAO: ServerDAO)
            -initViewListeners() void
            -extractServerIdFromSlotData(slotData: String) String
            +loadVisualRack(rackId: String) void
            +openBatchForm(operationType: String, selectedSlots: List~Integer~) void
            +executeBatchOperation(type: String, servers: List~Server~, targetRackId: String) void
        }

        class ServerController {
            -serverView : ServerDetailView
            -serverDAO : ServerDAO
            -statThread : MonitorThread
            -currentServer : Server
            -onUpdateSuccess : Runnable
            +ServerController(serverDAO: ServerDAO)
            +setOnUpdateSuccessCallback(onUpdateSuccess: Runnable) void
            -initViewListeners() void
            +loadServerInfo(serverId: String) void
            +updateManualUtilization(cpu: double, ram: double, storage: int) void
            +startMonitoring() void
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  LAYER 3 — view (Swing UI Components)
    %% ══════════════════════════════════════════════════════

    namespace view {
        class BaseView {
            <<JFrame>>
            -itemChangeLocation : JMenuItem
            -itemAddRoom : JMenuItem
            -itemNavDashboard : JMenuItem
            -itemNavMap : JMenuItem
            -cardsContainer : JPanel
            -cardLayout : CardLayout
            -itemPurgeRoom : JMenuItem
            -dashboardView : DashboardView
            -viewport : Viewport
            -bottomToolbar : JPanel
            -btnSelect : JButton
            -btnBuildRack : JButton
            -btnBuildPath : JButton
            -btnDemolish : JButton
            +BaseView()
            -createGameButton(text: String) JButton
            +updateViewportRoom(room: DataCenterRoom) void
            +navToDashboard() void
            +navToMap() void
            +setDashboardTitle(roomName: String) void
            +getItemNavDashboard() JMenuItem
            +getItemNavMap() JMenuItem
            +getViewport() Viewport
            +getBtnSelect() JButton
            +getBtnBuildRack() JButton
            +getBtnBuildPath() JButton
            +getItemChangeLocation() JMenuItem
            +getItemAddRoom() JMenuItem
            +getBtnDemolish() JButton
            +getItemPurgeRoom() JMenuItem
        }

        class DashboardView {
            <<JPanel>>
            -room : DataCenterRoom
            -totalRacks : int
            -totalCapacityU : int
            -usedCapacityU : int
            -totalServers : int
            -onlineServers : int
            -offlineServers : int
            -maintServers : int
            -totalCores : int
            -totalRamGB : int
            -totalStorageGB : int
            -avgCpu : double
            -avgRam : double
            +DashboardView(room: DataCenterRoom)
            +updateData(room: DataCenterRoom) void
            -calculateMetrics() void
            -buildUI() void
            -createSummaryCard(title: String, mainValueHtml: String, footer: String) JPanel
            -createChartContainer(title: String) JPanel
            -createLegendItem(label: String, color: Color) JPanel
        }

        class DonutChartPanel {
            <<inner class>>
            +DonutChartPanel()
            #paintComponent(g: Graphics) void
        }

        class ModernBarChartPanel {
            <<inner class>>
            +ModernBarChartPanel()
            #paintComponent(g: Graphics) void
        }

        class Viewport {
            <<JPanel>>
            -room : DataCenterRoom
            -cameraX : int
            -cameraY : int
            -TILE_SIZE : int
            -lastMouseX : int
            -lastMouseY : int
            -holdMouseX : int
            -holdMouseY : int
            -isClicking : boolean
            -upPressed : boolean
            -downPressed : boolean
            -leftPressed : boolean
            -rightPressed : boolean
            -cameraTimer : Timer
            -currentMode : Mode
            -interactionTimer : Timer
            -holdProgress : int
            -isHoldingRack : boolean
            -selectedRackToMove : ServerRack
            +Viewport(room: DataCenterRoom)
            +setMode(mode: Mode) void
            -setupKeyboardInteractions() void
            -updateCamera() void
            -setupMouseInteractions() void
            -getRackAt(gridX: int, gridY: int) ServerRack
            -getPathAt(gridX: int, gridY: int) RoomPath
            -isPathAt(gridX: int, gridY: int) boolean
            -canPlaceRack(startX: int, startY: int, ignoreRack: ServerRack) boolean
            -buildPath(x: int, y: int) void
            -buildRack(x: int, y: int) void
            +screenToGrid(screenX: int, screenY: int) Point
            #paintComponent(g: Graphics) void
        }

        class Mode {
            <<enumeration>>
            SELECT
            BUILD_RACK
            BUILD_PATH
            DEMOLISH
        }

        class RackDetailView {
            <<JDialog>>
            -slotsVisualPanel : JPanel
            -btnBatchAdd : JButton
            -btnBatchDelete : JButton
            -btnBatchUpdate : JButton
            -btnBatchMove : JButton
            -btnShowDetail : JButton
            -slotButtons : JToggleButton[]
            -lblRackInfo : JLabel
            -lblRackZone : JLabel
            -lblInstruction : JLabel
            -actionPanel : JPanel
            -interactionTimer : Timer
            -holdProgress : int
            -isHoldingServer : boolean
            -isClicking : boolean
            -selectedServerToMove : HardwareEquipment
            -selectedStartSlot : int
            -lastMouseX : int
            -lastMouseY : int
            -holdMouseX : int
            -holdMouseY : int
            -serverMoveListener : ServerMoveListener
            +RackDetailView()
            +setServerMoveListener(listener: ServerMoveListener) void
            +renderRackSlots(rack: ServerRack) void
            -extractId(slotText: String) String
            +getSelectedEmptySlots() List~Integer~
            +getSelectedOccupiedSlots() List~Integer~
            -fireSelectionChanged() void
            +getSlotButtons() JToggleButton[]
            +getBtnBatchAdd() JButton
            +getBtnBatchDelete() JButton
            +getBtnBatchUpdate() JButton
            +getBtnBatchMove() JButton
            +getBtnShowDetail() JButton
        }

        class ServerMoveListener {
            <<inner interface>>
            +onServerMovedWithinRack(serverId: String, oldStartSlot: int, targetStartSlot: int) void
        }

        class BatchServerFormView {
            <<JDialog>>
            -dynamicFormPanel : JPanel
            -btnAddRow : JButton
            -btnExecute : JButton
            -cbTargetRack : JComboBox~String~
            -maxAllowedCapacityU : int
            -currentFormU : int
            -operationType : String
            -rowUIs : List~ServerRowUI~
            -nextServerId : int
            +BatchServerFormView(maxCapacityU: int, operationType: String, availableRacks: List~String~)
            +addFormRow(existingServer: Server) void
            +removeFormRow(rowPanel: JPanel, uiReference: ServerRowUI) void
            +validateCapacity(requiredU: int) boolean
            +getBatchData() List~Server~
            +getSelectedTargetRack() String
            +getBtnExecute() JButton
        }

        class ServerRowUI {
            <<inner class>>
            ~panel : JPanel
            ~txtId : JTextField
            ~txtModel : JTextField
            ~txtCpuName : JTextField
            ~txtCpu : JTextField
            ~txtRam : JTextField
            ~txtDisk : JTextField
            ~btnDeleteRow : JButton
            ~originalSlot : int
            +ServerRowUI(existingServer: Server)
        }

        class BatchProgressDialog {
            <<JDialog>>
            -progressBar : JProgressBar
            -lblStatus : JLabel
            +BatchProgressDialog()
            +updateProgress(current: int, total: int, msg: String) void
        }

        class ServerDetailView {
            <<JPanel>>
            -cbStatus : JComboBox~String~
            -txtInputCpu : JTextField
            -txtInputRam : JTextField
            -txtInputStorage : JTextField
            -btnSetUtil : JButton
            -pbCpuUtilization : JProgressBar
            -pbRamUtilization : JProgressBar
            -pbStorage : JProgressBar
            -lblServerId : JLabel
            -lblCpuName : JLabel
            -lblOsType : JLabel
            -lblStatus : JLabel
            -statusIcon : StatusIcon
            +ServerDetailView()
            -createCustomBar(title: String) JProgressBar
            +displayServerStats(s: Server) void
            +updateCpuBar(util: double) void
            +updateRamBar(util: double) void
            +updateStorageBar(used: int, total: int) void
            +getBtnSetUtil() JButton
            +getInputCpu() String
            +getInputRam() String
            +getInputStorage() String
            +getSelectedStatus() String
        }

        class StatusIcon {
            <<inner class · Icon>>
            -color : Color
            +setColor(c: Color) void
            +paintIcon(c: Component, g: Graphics, x: int, y: int) void
            +getIconWidth() int
            +getIconHeight() int
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  LAYER 4 — thread (Background Processing)
    %% ══════════════════════════════════════════════════════

    namespace thread {
        class BatchOperationThread {
            <<extends Thread>>
            -operationType : String
            -serversList : List~Server~
            -targetRackId : String
            -serverDAO : ServerDAO
            -sourceRack : ServerRack
            -destinationRack : ServerRack
            -progressView : BatchProgressDialog
            -onSuccessCallback : Runnable
            +BatchOperationThread(operationType: String, serversList: List~Server~, targetRackId: String, sourceRack: ServerRack, serverDAO: ServerDAO, progressView: BatchProgressDialog)
            +setDestinationRack(destinationRack: ServerRack) void
            +setOnSuccessCallback(callback: Runnable) void
            +run() void
            -processAdd() void
            -processUpdate() void
            -processDelete() void
            -processMove() void
            -updateProgress(current: int, total: int, msg: String) void
            -simulateDelay(ms: int) void
        }

        class MonitorThread {
            <<extends Thread>>
            -server : Server
            -view : ServerDetailView
            -isRunning : boolean
            +MonitorThread(server: Server, view: ServerDetailView)
            +run() void
            +stopMonitoring() void
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  LAYER 5 — dao (Data Access Layer)
    %% ══════════════════════════════════════════════════════

    namespace dao {
        class ICRUD~T~ {
            <<interface>>
            +create(item: T) boolean
            +read(id: String) T
            +update(item: T) boolean
            +delete(id: String) boolean
            +getAll() List~T~
        }

        class DatabaseConnector {
            <<Singleton>>
            -instance : DatabaseConnector$
            -connection : Connection
            -DBNAME : String
            -URL_DB : String
            -USERNAME : String
            -PASSWORD : String
            -DatabaseConnector()
            +getInstance() DatabaseConnector$
            +getConnection() Connection
        }

        class ServerDAO {
            -connection : Connection
            +ServerDAO()
            +create(item: Server) boolean
            +read(id: String) Server
            +update(item: Server) boolean
            +delete(id: String) boolean
            +getAll() List~Server~
            +getServersByRack(rackId: String) List~Server~
            +moveServerRack(serverId: String, newRackId: String) boolean
            +getNextServerId() int
            -extractServerFromResultSet(rs: ResultSet) Server
            +updateServerSlot(idAsset: String, startSlot: int) boolean
        }

        class RackDAO {
            -connection : Connection
            +RackDAO()
            +create(rack: ServerRack, roomName: String) boolean
            +getRacksByRoom(roomName: String) List~ServerRack~
            +updateLocation(rackId: String, newX: int, newY: int) boolean
            +delete(rackId: String) boolean
        }

        class RoomDAO {
            -connection : Connection
            +RoomDAO()
            +getAllRoomNames() List~String~
            +createRoom(roomName: String, widthGrid: int, heightGrid: int) boolean
            +getRoomIdByName(roomName: String) int
            +getRoomByName(roomName: String) DataCenterRoom
            +purgeRoomContent(roomName: String) boolean
        }

        class PathDAO {
            -connection : Connection
            +PathDAO()
            +createPath(path: RoomPath, roomName: String) boolean
            +getPathsByRoom(roomName: String) List~RoomPath~
            +deletePath(xCoord: int, yCoord: int, roomName: String) boolean
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  LAYER 6 — model (Domain Entities)
    %% ══════════════════════════════════════════════════════

    namespace model {
        class IManageable {
            <<interface>>
            +turnOn() void
            +turnOff() void
            +restart() void
        }

        class IMonitorable {
            <<interface>>
            +getTemperature() double
            +getPowerDraw() double
            +getStatus() String
        }

        class HardwareEquipment {
            <<abstract>>
            -idAsset : String
            -modelName : String
            -sizeInU : int
            -status : String
            +HardwareEquipment(idAsset: String, modelName: String, sizeInU: int, status: String)
            +getDetails() String*
            +getIdAsset() String
            +getModelName() String
            +getSizeInU() int
            +getStatus() String
            +setStatus(status: String) void
        }

        class ComputingDevice {
            <<abstract>>
            -cpuCores : int
            -totalRamGB : int
            +ComputingDevice(idAsset: String, modelName: String, sizeInU: int, status: String, cpuCores: int, totalRamGB: int)
            +calculateLoad() double*
            +getCpuCores() int
            +getTotalRamGB() int
        }

        class Server {
            -osType : String
            -cpuName : String
            -cpuUtilization : double
            -ramUtilization : double
            -totalStorageGB : int
            -usedStorageGB : int
            -startSlot : int
            -rackId : String
            +Server(idAsset: String, modelName: String, sizeInU: int, status: String, cpuName: String, cpuCores: int, totalRamGB: int, osType: String, totalStorageGB: int, usedStorageGB: int)
            +getDetails() String
            +calculateLoad() double
            +setStatus(status: String) void
            +getCpuName() String
            +setCpuName(cpuName: String) void
            +setUsedStorageGB(usedStorageGB: int) void
            +getCpuUtilization() double
            +setCpuUtilization(cpuUtilization: double) void
            +getRamUtilization() double
            +setRamUtilization(ramUtilization: double) void
            +getOsType() String
            +getTotalStorageGB() int
            +getUsedStorageGB() int
            +getStartSlot() int
            +setStartSlot(startSlot: int) void
            +setRackId(rackId: String) void
            +getRackId() String
            +getTemperature() double
            +getPowerDraw() double
            +turnOn() void
            +turnOff() void
            +restart() void
        }

        class GridLocation {
            -xCoordinate : int
            -yCoordinate : int
            -zoneName : String
            +GridLocation(xCoordinate: int, yCoordinate: int, zoneName: String)
            +GridLocation(xCoordinate: int, yCoordinate: int)
            +setCoordinates(x: int, y: int) void
            +getLocationString() String
            +getxCoordinate() int
            +getyCoordinate() int
            +getZoneName() String
        }

        class RoomPath {
            -idPath : int
            -idRoom : int
            -xCoord : int
            -yCoord : int
            +RoomPath(idPath: int, idRoom: int, xCoord: int, yCoord: int)
            +RoomPath(xCoord: int, yCoord: int)
            +getXCoord() int
            +getYCoord() int
            +getIdPath() int
        }

        class ServerRack {
            -rackId : String
            -maxCapacityU : int
            -currentUsedU : int
            -location : GridLocation
            -slots : HardwareEquipment[]
            +ServerRack(rackId: String, maxCapacityU: int, location: GridLocation)
            +addEquipment(hw: HardwareEquipment, startSlot: int) boolean
            +removeEquipment(idAsset: String) boolean
            +canAccommodate(requiredU: int) boolean
            +getAvailableU() int
            +getVisualRepresentation() String[]
            +getRackId() String
            +getHardwareList() List~HardwareEquipment~
            +getLocation() GridLocation
            +getMaxCapacityU() int
        }

        class DataCenterRoom {
            -roomName : String
            -widthGrid : int
            -heightGrid : int
            -racks : List~ServerRack~
            -paths : List~RoomPath~
            +DataCenterRoom(roomName: String)
            +addRack(rack: ServerRack) void
            +addRack(newRacks: List~ServerRack~) void
            +findRackById(rackId: String) ServerRack
            +addPath(path: RoomPath) void
            +setDimensions(w: int, h: int) void
            +getPaths() List~RoomPath~
            +getAllRacks() List~ServerRack~
            +getRoomName() String
            +getWidthGrid() int
            +getHeightGrid() int
        }
    }

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — model (Inheritance & Realization)
    %% ══════════════════════════════════════════════════════

    HardwareEquipment ..|> IManageable : implements
    HardwareEquipment ..|> IMonitorable : implements
    ComputingDevice --|> HardwareEquipment : extends
    Server --|> ComputingDevice : extends

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — model (Composition & Aggregation)
    %% ══════════════════════════════════════════════════════

    DataCenterRoom *-- "0..*" ServerRack : racks
    DataCenterRoom *-- "0..*" RoomPath : paths
    ServerRack *-- "1" GridLocation : location
    ServerRack o-- "0..*" HardwareEquipment : slots

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — view (Inner Classes)
    %% ══════════════════════════════════════════════════════

    BaseView *-- DashboardView : contains
    BaseView *-- Viewport : contains
    Viewport *-- Mode : inner enum
    RackDetailView *-- ServerMoveListener : inner interface
    BatchServerFormView *-- ServerRowUI : inner class
    ServerDetailView *-- StatusIcon : inner class
    DashboardView *-- DonutChartPanel : inner class
    DashboardView *-- ModernBarChartPanel : inner class

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — dao (Realization & Singleton)
    %% ══════════════════════════════════════════════════════

    ServerDAO ..|> ICRUD~T~ : implements
    ServerDAO ..> DatabaseConnector : uses
    RackDAO ..> DatabaseConnector : uses
    RoomDAO ..> DatabaseConnector : uses
    PathDAO ..> DatabaseConnector : uses

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — main → controller (Entry Point)
    %% ══════════════════════════════════════════════════════

    Main ..> MainController : creates
    Main ..> BaseView : creates

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — controller → view (MVC Pattern)
    %% ══════════════════════════════════════════════════════

    MainController --> BaseView : mainView
    MainController --> DataCenterRoom : dataCenterModel
    RackController --> RackDetailView : rackView
    RackController --> ServerRack : currentRack
    RackController --> DataCenterRoom : roomModel
    ServerController --> ServerDetailView : serverView
    ServerController --> Server : currentServer

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — controller → dao
    %% ══════════════════════════════════════════════════════

    RackController --> ServerDAO : serverDAO
    ServerController --> ServerDAO : serverDAO

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — controller → thread
    %% ══════════════════════════════════════════════════════

    RackController ..> BatchOperationThread : creates
    ServerController --> MonitorThread : statThread

    %% ══════════════════════════════════════════════════════
    %%  RELATIONSHIPS — thread → view & dao
    %% ══════════════════════════════════════════════════════

    BatchOperationThread --> BatchProgressDialog : progressView
    BatchOperationThread --> ServerDAO : serverDAO
    MonitorThread --> ServerDetailView : view
    MonitorThread --> Server : server
